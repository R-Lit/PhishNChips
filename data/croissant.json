  "@type": "sc:Dataset",
  "name": "PhishNChips",
  "description": "The PhishNChips benchmark: 2,000-email core dataset for evaluating how LLM email-agent security behavior changes under different system prompt configurations. Includes 220,000 adjudicated benchmark evaluations across 11 models and 10 prompt strategies, plus auxiliary validation and infrastructure stress-test files. All third-party sources cleared for academic redistribution with attribution.",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "license": "https://huggingface.co/datasets/AreLit/PhishNChips/blob/main/SOURCE_LICENSES.md",
  "url": "https://huggingface.co/datasets/AreLit/PhishNChips",
  "version": "1.2.0",
  "creator": {
    "@type": "Person",
    "name": "Ron Litvak"
  },
  "keywords": [
    "phishing detection",
    "llm security",
    "benchmark",
    "email security",
    "prompt sensitivity"
  ],
  "citeAs": "@article{litvak2026phishnchips, title={The System Prompt Is the Attack Surface: How {LLM} Agent Configuration Shapes Security and Creates Exploitable Vulnerabilities}, author={Litvak, Ron}, journal={arXiv preprint}, year={2026}}",
