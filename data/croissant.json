  "data": {
    "responsible_ai": {
      "synthetic_data": true,
      "construct_validity": "PhishNChips is intended to measure prompt-model interaction in LLM email-agent phishing detection under controlled stimuli. It is not intended to estimate production false-positive rates or enterprise base-rate risk.",
      "data_limitations": [
        "Core emails are synthetic, although phishing URLs are real and sourced from public phishing feeds.",
        "The v5 release improves legitimate-distribution coverage by integrating 333 cross-domain legitimate emails, but the benchmark remains a constructed evaluation distribution rather than a production traffic sample.",
        "English-only coverage.",
        "Model, URL, and prompt snapshot corresponds to early 2026.",
        "The infrastructure-phishing auxiliary split is useful for stress testing but still smaller than the originally desired expansion target."
      ],
      "data_biases": [
        "Synthetic language may encode generator-specific style biases.",
        "Legitimate emails emphasize workplace and transactional patterns rather than the full diversity of real-world email.",
        "Prompt-based results may not generalize to agents with richer metadata, user history, or threat-intelligence tools."
      ],
      "personal_or_sensitive_information": "The release contains phishing content and real malicious URLs. It does not intentionally contain private inbox data, but the URLs themselves are operationally sensitive and should not be opened during casual inspection.",
      "data_use_cases": {
        "intended": [
          "Benchmarking LLM email-security behavior.",
          "Studying prompt sensitivity and deployment configuration effects.",
          "Reproducing the PhishNChips benchmark and derived analyses."
        ],
        "out_of_scope": [
          "Direct production deployment without additional safety controls.",
          "Estimating real-world phishing prevalence or calibrated enterprise risk.",
          "Using raw URLs outside controlled research environments."
        ]
      },
      "social_impact": "The benchmark can help researchers and deployers identify brittle prompt-level defenses in agentic systems, but mishandling the raw phishing URLs or overstating the benchmark as real-world prevalence evidence could create harm.",
      "provenance": {
        "phishing_urls": [
          "PhishTank (Cisco Talos)",
          "OpenPhish (Academic Research Approval)",
          "Nazario Phishing Corpus (CC-BY-4.0)",
          "GitHub Phishing Database (Community Repositories)"
        ],
        "legitimate_seed_domains": [
          "Tranco Research-Oriented Top Sites (NDSS 2019)",
          "Project-curated legitimate scenarios"
        ],
        "generator": "Gemini 3 Flash Preview for the released synthetic email bodies"
